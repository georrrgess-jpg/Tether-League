{
  "name": "tether-league",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tether League — a 2v2 robot ball sport built around tether swings, momentum and club progression.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:offline": "tsc --noEmit && vite build --config vite.offline.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "feasibility": "vite-node tools/feasibility.ts && vite-node tools/bank.ts",
    "sim": "vite-node tools/simulate.ts",
    "balance": "vite-node tools/balance.ts",
    "sweep": "vite-node tools/sweep.ts",
    "chassis": "vite-node tools/chassis.ts drills && vite-node tools/chassis.ts duel 200",
    "economy": "vite-node tools/economy.ts",
    "swingcheck": "vite-node tools/swingcheck.ts && vite-node tools/swingstats.ts 4 harbor_park club && vite-node tools/trialswing.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
